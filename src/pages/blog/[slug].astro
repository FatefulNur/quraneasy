---
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogArticle from "@/components/BlogArticle";
import type { BlogPost, LocaleMap } from "@/lib/content/types";

// ── Markdown (legacy) post types ──────────────────────────────────────────
interface MdFrontmatter {
  title: string;
  description?: string;
  date?: string;
  author?: string;
  tags?: string[];
  category?: string;
  modules?: string[];
  coverImage?: string;
  slide?: string;
}
type MdPost = { frontmatter: MdFrontmatter; Content: any; file: string };

// ── Module JSON for linkbacks ─────────────────────────────────────────────
type ModuleJson = { id: string; title: LocaleMap };

export async function getStaticPaths() {
  const jsonEntries = import.meta.glob<BlogPost>("@/content/blog/*.json", {
    eager: true,
  });
  const mdEntries = import.meta.glob<MdPost>("@/content/blog/*.md", {
    eager: true,
  });

  const jsonPaths = Object.values(jsonEntries).map((post) => ({
    params: { slug: post.id },
    props: { format: "json" as const, jsonPost: post, mdPost: null },
  }));

  // JSON slugs take priority — skip any MD file with the same slug
  const jsonSlugs = new Set(jsonPaths.map((p) => p.params.slug));
  const mdPaths = Object.entries(mdEntries)
    .map(([path, post]) => {
      const slug = path.split("/").pop()!.replace(/\.md$/, "");
      return {
        params: { slug },
        props: { format: "md" as const, mdPost: post, jsonPost: null, slug },
      };
    })
    .filter((p) => !jsonSlugs.has(p.params.slug));

  return [...jsonPaths, ...mdPaths];
}

const { format, jsonPost, mdPost } = Astro.props as {
  format: "json" | "md";
  jsonPost: BlogPost | null;
  mdPost: MdPost | null;
  slug?: string;
};

// ── Derive common metadata (for SEO in BlogLayout head) ───────────────────
const title =
  format === "json"
    ? (jsonPost!.title.en ?? "")
    : (mdPost!.frontmatter.title ?? "");

const description =
  format === "json"
    ? (jsonPost!.description?.en ?? undefined)
    : (mdPost!.frontmatter.description ?? undefined);

const date =
  format === "json" ? jsonPost!.date : (mdPost!.frontmatter.date ?? undefined);

const author =
  format === "json"
    ? (jsonPost!.author ?? "QuranEasy Team")
    : (mdPost!.frontmatter.author ?? "QuranEasy Team");

const coverImage =
  format === "json"
    ? (jsonPost!.coverImage ?? undefined)
    : (mdPost!.frontmatter.coverImage ?? undefined);

const slug =
  format === "json"
    ? jsonPost!.id
    : (Astro.props.slug as string);

const category =
  format === "json"
    ? (jsonPost!.category ?? undefined)
    : (mdPost!.frontmatter.category ?? undefined);

const tags =
  format === "json"
    ? (jsonPost!.tags ?? [])
    : (mdPost!.frontmatter.tags ?? []);

// ── Resolve module titles (all locales for React island) ──────────────────
const allModules = import.meta.glob<ModuleJson>("@/content/modules/*.json", {
  eager: true,
});
const moduleMap = Object.values(allModules).reduce<Record<string, LocaleMap>>(
  (acc, m) => {
    acc[m.id] = m.title;
    return acc;
  },
  {}
);

// ── MD-only: read time + linked modules ───────────────────────────────────
let mdReadTime = 1;
let mdLinkedModules: { id: string; title: string; href: string }[] = [];

if (format === "md") {
  const rawText = (await import(`../../content/blog/${slug}.md?raw`))
    .default as string;
  const body = rawText.replace(/---[\s\S]*?---/, "").trim();
  const words = body.split(/\s+/).filter(Boolean).length;
  mdReadTime = Math.max(1, Math.ceil(words / 200));

  const mdModules = mdPost!.frontmatter.modules ?? [];
  mdLinkedModules = mdModules.map((id) => ({
    id,
    title: (moduleMap[id] as any)?.en ?? id,
    href: `/learn/${id}`,
  }));
}

// ── MD-only: formatting helpers ───────────────────────────────────────────
const mdFormattedDate = date
  ? new Date(date).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    })
  : null;

const categoryGradients: Record<string, string> = {
  Tilawat: "from-emerald-600/20 via-emerald-400/10 to-transparent",
  Tajweed: "from-teal-600/20 via-cyan-400/10 to-transparent",
  Adab: "from-amber-500/20 via-yellow-300/10 to-transparent",
};
const mdHeroGradient =
  categoryGradients[category ?? ""] ??
  "from-stone-300/30 via-stone-100/10 to-transparent";

const Content = format === "md" ? mdPost!.Content : null;
---

<BlogLayout
  title={title}
  description={description}
  date={date}
  author={author}
  coverImage={coverImage ?? undefined}
  slug={slug}
>
  {format === "json" ? (
    <!-- JSON: React island renders header + hero + body (locale-aware) -->
    <BlogArticle client:load post={jsonPost!} moduleMap={moduleMap} />
  ) : (
    <!-- MD legacy: static rendering with simple header -->
    <div class="min-h-screen">
      <!-- Static site header for MD posts -->
      <header class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-sm">
        <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4">
          <a
            href="/"
            class="flex items-center gap-2 text-sm font-semibold text-foreground transition-opacity hover:opacity-80"
          >
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">
              Q
            </span>
            <span class="hidden sm:inline">QuranEasy</span>
          </a>
        </div>
      </header>

      <!-- Back nav -->
      <div class="mx-auto max-w-3xl px-4 pt-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Articles
        </a>
      </div>

      <!-- Hero band -->
      <div class="grain mt-4 mx-auto max-w-3xl overflow-hidden rounded-xl px-4">
        <div
          class:list={[
            "relative rounded-xl bg-parchment px-6 py-10 sm:px-10 sm:py-14",
            "bg-gradient-to-br",
            mdHeroGradient,
          ]}
          style="background-color: var(--parchment);"
        >
          {category && (
            <span class="mb-4 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary ring-1 ring-primary/20">
              {category}
            </span>
          )}
          <h1 class="font-serif text-balance text-3xl font-semibold leading-tight text-foreground sm:text-4xl lg:text-5xl">
            {title}
          </h1>
          {description && (
            <p class="mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
              {description}
            </p>
          )}
          {(mdFormattedDate || mdReadTime) && (
            <div class="ornament mt-6 text-xs text-muted-foreground">
              {mdFormattedDate && <span>{mdFormattedDate}</span>}
              {mdFormattedDate && <span aria-hidden="true">·</span>}
              <span>{mdReadTime} min read</span>
            </div>
          )}
        </div>
      </div>

      <!-- Article body -->
      <div class="mx-auto max-w-3xl px-4 py-10">
        <div class="prose prose-neutral max-w-none prose-headings:font-serif prose-headings:font-semibold prose-h2:text-2xl prose-h3:text-xl prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-blockquote:not-italic prose-blockquote:border-primary/40 prose-p:leading-relaxed">
          <Content />
        </div>

        {mdLinkedModules.length > 0 && (
          <div class="mt-10">
            <div class="hairline mb-6" />
            <p id="md-related-label" class="mb-3 text-xs font-medium uppercase tracking-widest text-muted-foreground">
              Related modules
            </p>
            <ul class="flex flex-col gap-2">
              {mdLinkedModules.map((m) => (
                <li>
                  <a
                    href={m.href}
                    class="group inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-3 text-sm font-medium text-foreground transition-all hover:border-primary/40 hover:bg-primary/5 hover:text-primary"
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="text-muted-foreground group-hover:text-primary transition-colors">
                      <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {m.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {tags.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">
                {tag}
              </span>
            ))}
          </div>
        )}

        <div class="mt-10">
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to Articles
          </a>
        </div>
      </div>
    </div>
  )}
<script>
  (function () {
    try {
      var loc = localStorage.getItem("qe:locale") || "en";
      var labels = { en: "Related modules", bn: "সম্পর্কিত মডিউল", ar: "الوحدات ذات الصلة" };
      var el = document.getElementById("md-related-label");
      if (el && labels[loc]) el.textContent = labels[loc];
    } catch (_) {}
  })();
</script>
</BlogLayout>
