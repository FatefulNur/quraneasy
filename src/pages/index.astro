---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadModules } from "@/lib/content/loadModules";
import LandingClient from "@/components/LandingClient";

const modules = loadModules();
---

<BaseLayout
  title="QuranEasy — A beginner's guide to Tilawat"
  description="A slow, reverent course on the rules of Quran recitation. Trilingual: English, Bangla, Arabic."
>
  <LandingClient modules={modules} client:load />
</BaseLayout>
