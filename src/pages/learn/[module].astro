---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadModules } from "@/lib/content/loadModules";
import SlideViewer from "@/components/SlideViewer";

export function getStaticPaths() {
  const modules = loadModules().sort((a, b) => a.recommendedOrder - b.recommendedOrder);
  return modules.map((m, i) => ({
    params: { module: m.id },
    props: {
      module: m,
      nextModule: modules[i + 1]
        ? { id: modules[i + 1].id, title: modules[i + 1].title }
        : null,
    },
  }));
}

const { module, nextModule } = Astro.props;
---

<BaseLayout title={`${module.title.en ?? module.id} · QuranEasy`} hideTelegram>
  <SlideViewer module={module} nextModule={nextModule} client:load />
</BaseLayout>
