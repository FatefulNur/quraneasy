---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  date?: string;
  author?: string;
  coverImage?: string;
  slug?: string;
  lang?: "en" | "bn" | "ar";
}

const {
  title,
  description = "",
  date,
  author = "QuranEasy Team",
  coverImage,
  slug,
  lang = "en",
} = Astro.props;

const dir = lang === "ar" ? "rtl" : "ltr";
const site = import.meta.env.SITE as string | undefined;
const canonical = site && slug ? `${site.replace(/\/$/, "")}/blog/${slug}` : undefined;
const ogTitle = `${title} · QuranEasy`;
const coverAbs = site && coverImage ? `${site.replace(/\/$/, "")}${coverImage}` : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  ...(description ? { description } : {}),
  ...(date ? { datePublished: date } : {}),
  author: { "@type": "Person", name: author },
  publisher: { "@type": "Organization", name: "QuranEasy" },
  ...(canonical ? { url: canonical } : {}),
  ...(coverAbs ? { image: coverAbs } : {}),
};
---

<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <!-- Blocking: read locale before first paint to prevent flash -->
    <script>
      (function () {
        try {
          var loc = localStorage.getItem("qe:locale");
          if (loc === "bn" || loc === "ar") {
            document.documentElement.dataset.locale = loc;
            document.documentElement.lang = loc;
            document.documentElement.dir = loc === "ar" ? "rtl" : "ltr";
            var s = document.createElement("style");
            s.id = "qe-locale-hide";
            s.textContent = ".locale-island { visibility: hidden }";
            document.head.appendChild(s);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{ogTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={ogTitle} />
    {description && <meta property="og:description" content={description} />}
    {coverAbs && <meta property="og:image" content={coverAbs} />}
    {canonical && <meta property="og:url" content={canonical} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={coverImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={ogTitle} />
    {description && <meta name="twitter:description" content={description} />}

    <!-- Canonical -->
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Cloudflare Web Analytics -->
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}></script>
    )}
  </head>
  <body class="bg-background text-foreground antialiased">
    <!-- Reading progress bar -->
    <div
      id="reading-progress"
      class="fixed top-0 left-0 z-[60] h-0.5 bg-gradient-to-r from-primary via-primary to-[var(--gold)] transition-[width] duration-100"
      style="width: 0%"
      aria-hidden="true"
    ></div>
    <script>
      (function () {
        const bar = document.getElementById("reading-progress");
        if (!bar) return;
        function update() {
          const scrolled = window.scrollY;
          const total = document.body.scrollHeight - window.innerHeight;
          const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
          bar.style.width = pct + "%";
        }
        window.addEventListener("scroll", update, { passive: true });
        update();
      })();
    </script>

    <slot />
    <a
      href="https://t.me/quraneasyguide"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Join our Telegram channel"
      class="group fixed bottom-5 end-5 z-50 flex items-center rounded-full bg-primary p-3.5 text-sm font-medium text-primary-foreground shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
        <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
      </svg>
      <span class="max-w-0 overflow-hidden whitespace-nowrap transition-[max-width,margin] duration-300 group-hover:max-w-[160px] group-hover:ms-2.5">Join Telegram</span>
    </a>
  </body>
</html>
