---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  date?: string;
  author?: string;
  coverImage?: string;
  slug?: string;
  lang?: "en" | "bn" | "ar";
}

const {
  title,
  description = "",
  date,
  author = "QuranEasy Team",
  coverImage,
  slug,
  lang = "en",
} = Astro.props;

const dir = lang === "ar" ? "rtl" : "ltr";
const site = import.meta.env.SITE as string | undefined;
const canonical = site && slug ? `${site.replace(/\/$/, "")}/blog/${slug}` : undefined;
const ogTitle = `${title} · QuranEasy`;
const coverAbs = site && coverImage ? `${site.replace(/\/$/, "")}${coverImage}` : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  ...(description ? { description } : {}),
  ...(date ? { datePublished: date } : {}),
  author: { "@type": "Person", name: author },
  publisher: { "@type": "Organization", name: "QuranEasy" },
  ...(canonical ? { url: canonical } : {}),
  ...(coverAbs ? { image: coverAbs } : {}),
};
---

<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <!-- Blocking: read locale before first paint to prevent flash -->
    <script>
      (function () {
        try {
          var loc = localStorage.getItem("qe:locale");
          if (loc === "bn" || loc === "ar") {
            document.documentElement.dataset.locale = loc;
            document.documentElement.lang = loc;
            document.documentElement.dir = loc === "ar" ? "rtl" : "ltr";
            var s = document.createElement("style");
            s.id = "qe-locale-hide";
            s.textContent = ".locale-island { visibility: hidden }";
            document.head.appendChild(s);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{ogTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={ogTitle} />
    {description && <meta property="og:description" content={description} />}
    {coverAbs && <meta property="og:image" content={coverAbs} />}
    {canonical && <meta property="og:url" content={canonical} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={coverImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={ogTitle} />
    {description && <meta name="twitter:description" content={description} />}

    <!-- Canonical -->
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "REPLACE_WITH_YOUR_TOKEN"}'></script>
  </head>
  <body class="bg-background text-foreground antialiased">
    <!-- Reading progress bar -->
    <div
      id="reading-progress"
      class="fixed top-0 left-0 z-50 h-0.5 bg-primary transition-[width] duration-100"
      style="width: 0%"
      aria-hidden="true"
    ></div>
    <script>
      (function () {
        const bar = document.getElementById("reading-progress");
        if (!bar) return;
        function update() {
          const scrolled = window.scrollY;
          const total = document.body.scrollHeight - window.innerHeight;
          const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
          bar.style.width = pct + "%";
        }
        window.addEventListener("scroll", update, { passive: true });
        update();
      })();
    </script>

    <slot />
  </body>
</html>
