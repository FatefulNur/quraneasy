---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "bn" | "ar";
}

const { title, description = "", lang = "en" } = Astro.props;
const dir = lang === "ar" ? "rtl" : "ltr";
---

<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <!-- Blocking: read locale before first paint to prevent flash -->
    <script>
      (function () {
        try {
          var loc = localStorage.getItem("qe:locale");
          if (loc === "bn" || loc === "ar") {
            document.documentElement.dataset.locale = loc;
            document.documentElement.lang = loc;
            document.documentElement.dir = loc === "ar" ? "rtl" : "ltr";
            var s = document.createElement("style");
            s.id = "qe-locale-hide";
            s.textContent = ".locale-island { visibility: hidden }";
            document.head.appendChild(s);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <!-- Cloudflare Web Analytics: cookieless, no personal data -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "REPLACE_WITH_YOUR_TOKEN"}'></script>
  </head>
  <body class="bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
