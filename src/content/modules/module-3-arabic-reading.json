{
  "id": "module-3-arabic-reading",
  "order": 3,
  "recommendedOrder": 3,
  "title": {
    "en": "Arabic Reading Foundations",
    "bn": "আরবি পড়ার ভিত্তি",
    "ar": "أساسيات القراءة العربية"
  },
  "summary": {
    "en": "Master the vowel marks (harakat), silent letters, double letters, and double vowels that form the foundation of Arabic reading.",
    "bn": "স্বরচিহ্ন (হারাকাত), নিরব অক্ষর, দ্বিগুণ অক্ষর এবং দ্বিগুণ স্বর যা আরবি পড়ার ভিত্তি তৈরি করে তা আয়ত্ত করুন।",
    "ar": "أتقن علامات الحركات والحروف الساكنة والحروف المشددة والتنوين التي تشكل أساس القراءة العربية."
  },
  "submodules": [
    {
      "id": "harakat",
      "title": {
        "en": "Harakat (Vowels)",
        "bn": "হারাকাত (স্বরচিহ্ন)",
        "ar": "الحركات"
      },
      "definition": {
        "en": "Harakat are small marks placed above or below letters that create vowel sounds — they are essential for correct pronunciation.",
        "bn": "হারাকাত হল ছোট চিহ্ন যা অক্ষরের উপরে বা নিচে রাখা হয় এবং a, i, u ধ্বনি তৈরি করে — সঠিক উচ্চারণের জন্য এগুলি অপরিহার্য।",
        "ar": "الحركات علامات صغيرة توضع فوق أو تحت الحروف لتُنتج أصوات الحركات (الفتحة والكسرة والضمة) — وهي ضرورية للنطق الصحيح."
      },
      "subtopics": [
