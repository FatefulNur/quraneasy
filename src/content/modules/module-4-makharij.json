{
  "id": "module-4-makharij",
  "order": 4,
  "recommendedOrder": 4,
  "title": {
    "en": "Makharij (Points of Articulation)",
    "bn": "মাখারিজ (উচ্চারণ স্থল)",
    "ar": "المخارج"
  },
  "summary": {
    "en": "Learn where each Arabic letter is pronounced — from the oral cavity, throat, tongue, lips, and nasal passage.",
    "bn": "আরবি প্রতিটি অক্ষর কোথায় উচ্চারণ করা হয় তা শিখুন — মুখগহ্বর, কণ্ঠনালি, জিহ্বা, ঠোঁট এবং নাক থেকে।",
    "ar": "تعلم من أين ينطق كل حرف عربي — من الجوف والحلق واللسان والشفتين والأنف."
  },
  "submodules": [
    {
      "id": "jawf",
      "title": {
        "en": "Jawf (Oral Cavity)",
        "bn": "জাওফ (মুখগহ্বর)",
        "ar": "الجوف"
      },
      "definition": {
        "en": "The jawf is the entire mouth and throat cavity; three letters come from this point: alif, waw, and ya.",
        "bn": "জাওফ হল সম্পূর্ণ মুখ এবং গলার গহ্বর; তিনটি অক্ষর এই স্থান থেকে আসে: আলিফ, ওয়াও এবং ইয়া।",
        "ar": "الجوف هو تجويف الفم والحلق بأكمله؛ ثلاثة حروف تخرج من هذا المخرج: الألف والواو والياء."
      },
      "letterExamples": [
        {
          "arabic": "ا",
          "translit": "a"
        },
        {
          "arabic": "و",
          "translit": "w"
        },
        {
          "arabic": "ي",
          "translit": "y"
        }
      ],
      "wordExamples": [
        {
          "arabic": "قَالَ",
          "translit": "qal",
          "meaning": {
            "en": "He said",
            "bn": "সে বলল"
          }
        },
        {
          "arabic": "يَقُولُ",
          "translit": "yaqul",
          "meaning": {
            "en": "He says",
            "bn": "সে বলে"
          }
        },
        {
          "arabic": "قِيلَ",
          "translit": "qil",
          "meaning": {
            "en": "It was said",
            "bn": "এটি বলা হয়েছিল"
          }
        },
        {
          "arabic": "نُوحِي",
          "translit": "nuhi",
          "meaning": {
            "en": "We reveal",
            "bn": "আমরা প্রকাশ করি"
          }
        },
        {
          "arabic": "فِيهِ",
          "translit": "fihi",
          "meaning": {
            "en": "In it",
            "bn": "এর মধ্যে"
          }
        }
      ],
      "checkItem": {
        "en": "I know that alif, waw, and ya come from the jawf.",
        "bn": "আমি জানি যে আলিফ, ওয়াও এবং ইয়া জাওফ থেকে আসে।",
        "ar": "تعلَّمتَ أن الألف والواو والياء تخرج من الجوف."
      }
    },
    {
      "id": "throat",
      "title": {
        "en": "Halq (Throat)",
        "bn": "হালক (কণ্ঠনালি)",
        "ar": "الحلق"
      },
      "definition": {
        "en": "The throat has three regions for different letters: lower throat, middle throat, and upper throat.",
        "bn": "কণ্ঠনালির তিনটি অঞ্চল রয়েছে বিভিন্ন অক্ষরের জন্য: নিম্ন কণ্ঠনালি, মধ্য কণ্ঠনালি এবং উপরের কণ্ঠনালি।",
        "ar": "الحلق له ثلاث مناطق لحروف مختلفة: أسفل الحلق ووسطه وأعلاه."
      },
