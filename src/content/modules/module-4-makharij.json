    {
      "id": "tongue",
      "title": {
        "en": "Tongue",
        "bn": "জিহ্বা",
        "ar": "اللسان"
      },
      "definition": {
        "en": "Many Arabic letters are produced from different parts of the tongue — this is the largest articulation point.",
        "bn": "অনেক আরবি অক্ষর জিহ্বার বিভিন্ন অংশ থেকে উত্পাদিত হয় — এটি সবচেয়ে বড় উচ্চারণ স্থল।",
        "ar": "العديد من الحروف العربية تنطق من أجزاء مختلفة من اللسان — وهو أكبر مخرج."
      },
